{
  "settings": {
    "port": 3000,
    "cors": true,
    "delay": 0
  },
  "routes": [
    {
      "id": "775c4aad193d",
      "name": "Health check",
      "method": "GET",
      "path": "/api/health",
      "status": 200,
      "delay": 0,
      "failRate": 0,
      "failStatus": 500,
      "enabled": true,
      "headers": {},
      "body": {
        "status": "ok",
        "time": "{{now}}"
      }
    },
    {
      "id": "144575939321",
      "name": "Login",
      "method": "POST",
      "path": "/api/auth/login",
      "status": 200,
      "delay": 300,
      "failRate": 0,
      "failStatus": 500,
      "enabled": true,
      "headers": {},
      "body": {
        "token": "{{uuid}}",
        "user": {
          "email": "{{body.email || \"guest@example.com\"}}",
          "name": "{{fullName}}"
        }
      }
    },
    {
      "id": "66bf419ba818",
      "name": "Current user",
      "method": "GET",
      "path": "/api/me",
      "status": 200,
      "delay": 0,
      "failRate": 0,
      "failStatus": 500,
      "enabled": true,
      "headers": {
        "Cache-Control": "no-store"
      },
      "body": {
        "id": 1,
        "name": "Ada Lovelace",
        "email": "ada@example.com",
        "role": "admin"
      }
    }
  ],
